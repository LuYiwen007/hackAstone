//# sourceMappingURL=LoginPage.js.mapÂ”ÙZ/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entry/src/main/ets/common/ArenaTheme.etsÙ[/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entry/src/main/ets/route/GlobalStores.etsÙX/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entry/src/main/ets/route/AppRoutes.etsÙU/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entry/src/main/ets/api/ArenaAPI.etsÙX/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entry/src/main/ets/pages/LoginPage.etsÔrB›ªmoduleName±isLocalDependency¯isNodeEntryFile§pkgPath±belongProjectPath§pkgNameªpkgVersion±dependencyPkgInfo¯hostModulesInfo°belongModulePath¬shouldEmitJs¥entryÃÂÙ7/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entryÙ1/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams¥entry¥1.0.0Ô␀␀‘ÔrC’²hostDependencyName®hostModuleName«./LoginPage¥entryÙ7/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entryÃÃÚ\import { ArenaTheme } from '../common/ArenaTheme';
import { authStore, localeStore } from '../route/GlobalStores';
import { AppRoutes } from '../route/AppRoutes';
import { ArenaAPI } from '../api/ArenaAPI';

/** ç™»å½• / æ³¨å†Œé¡µï¼Œå¯¹é½ iOS `LoginView`ã€‚ */
@Component
export struct LoginPage {
  @Prop pageStack: NavPathStack = new NavPathStack();

  @State isRegister: boolean = false;
  @State email: string = '';
  @State account: string = '';
  @State password: string = '';
  @State nickname: string = '';
  @State showPassword: boolean = false;
  @State loading: boolean = false;
  @State error: string = '';

  private localizedLoginError(err: Error): string {
    const msg = err.message ?? '';
    if (msg.includes('1002') || msg.includes('ç”¨æˆ·ä¸å­˜åœ¨')) {
      return localeStore.L.errorUserNotExist;
    }
    if (msg.includes('1003') || msg.includes('å¯†ç é”™è¯¯')) {
      return localeStore.L.errorPassword;
    }
    if (msg.includes('1001') || msg.includes('ç”¨æˆ·å·²å­˜åœ¨')) {
      return localeStore.L.errorUserExist;
    }
    if (msg.includes('è¯¥é‚®ç®±å·²è¢«æ³¨å†Œ')) {
      return localeStore.L.errorEmailTaken;
    }
    if (msg.includes('è¯¥æ˜µç§°å·²è¢«ä½¿ç”¨')) {
      return localeStore.L.errorNicknameTaken;
    }
    return msg.length > 0 ? msg : localeStore.L.errorGeneric;
  }

  private async submit(): Promise<void> {
    this.loading = true;
    this.error = '';
    try {
      if (this.isRegister) {
        const trimmedEmail = this.email.trim();
        const trimmedNick = this.nickname.trim();
        await ArenaAPI.register(trimmedEmail, this.password, trimmedNick);
        const session = await ArenaAPI.login(trimmedEmail.toLowerCase(), this.password);
        authStore.save(session);
      } else {
        const session = await ArenaAPI.login(this.account.trim(), this.password);
        authStore.save(session);
      }
      this.pageStack.clear();
      this.pageStack.pushPath({ name: AppRoutes.profile() });
    } catch (e) {
      this.error = this.localizedLoginError(e instanceof Error ? e : new Error(String(e)));
    } finally {
      this.loading = false;
    }
  }

  build() {
    Scroll() {
      Column({ space: 24 }) {
        Column({ space: 8 }) {
          Text('ğŸ§ ')
            .fontSize(48)
          Text(this.isRegister ? localeStore.L.registerTitle : localeStore.L.loginTitle)
            .fontSize(28)
            .fontWeight(FontWeight.Bold)
            .fontColor(ArenaTheme.textPrimary)
          Text(this.isRegister ? localeStore.L.registerSubtitle : localeStore.L.loginSubtitle)
            .fontSize(14)
            .fontColor(ArenaTheme.textMuted)
        }
        .width('100%')
        .padding({ top: 24 })

        if (this.error.length > 0) {
          Text(this.error)
            .fontSize(12)
            .fontColor(Color.Red)
            .width('100%')
            .padding(12)
            .backgroundColor('#FF00001F')
            .borderRadius(10)
        }

        Column({ space: 16 }) {
          if (this.isRegister) {
            Column({ space: 6 }) {
              Text(localeStore.L.email)
                .fontSize(12)
                .fontWeight(FontWeight.Medium)
                .fontColor(ArenaTheme.textMuted)
              TextInput({ placeholder: localeStore.L.emailPlaceholder, text: this.email })
                .fontColor(ArenaTheme.textPrimary)
                .backgroundColor(ArenaTheme.surface)
                .padding(12)
                .borderRadius(10)
                .border({ width: 1, color: ArenaTheme.border })
                .onChange((v: string) => { this.email = v; })
            }
            .alignItems(HorizontalAlign.Start)
            .width('100%')

            Column({ space: 6 }) {
              Text(localeStore.L.nickname)
                .fontSize(12)
                .fontWeight(FontWeight.Medium)
                .fontColor(ArenaTheme.textMuted)
              TextInput({ placeholder: localeStore.L.nicknamePrompt, text: this.nickname })
                .fontColor(ArenaTheme.textPrimary)
                .backgroundColor(ArenaTheme.surface)
                .padding(12)
                .borderRadius(10)
                .border({ width: 1, color: ArenaTheme.border })
                .onChange((v: string) => { this.nickname = v; })
            }
            .alignItems(HorizontalAlign.Start)
            .width('100%')
          } else {
            Column({ space: 6 }) {
              Text(localeStore.L.loginAccountLabel)
                .fontSize(12)
                .fontWeight(FontWeight.Medium)
                .fontColor(ArenaTheme.textMuted)
              TextInput({ placeholder: localeStore.L.loginAccountPlaceholder, text: this.account })
                .fontColor(ArenaTheme.textPrimary)
                .backgroundColor(ArenaTheme.surface)
                .padding(12)
                .borderRadius(10)
                .border({ width: 1, color: ArenaTheme.border })
                .onChange((v: string) => { this.account = v; })
            }
            .alignItems(HorizontalAlign.Start)
            .width('100%')
          }

          Column({ space: 6 }) {
            Text(localeStore.L.password)
              .fontSize(12)
              .fontWeight(FontWeight.Medium)
              .fontColor(ArenaTheme.textMuted)
            Row() {
              if (this.showPassword) {
                TextInput({ placeholder: localeStore.L.passwordPlaceholder, text: this.password })
                  .layoutWeight(1)
                  .fontColor(ArenaTheme.textPrimary)
                  .type(InputType.Normal)
                  .onChange((v: string) => { this.password = v; })
              } else {
                TextInput({ placeholder: localeStore.L.passwordPlaceholder, text: this.password })
                  .layoutWeight(1)
                  .fontColor(ArenaTheme.textPrimary)
                  .type(InputType.Password)
                  .onChange((v: string) => { this.password = v; })
              }
              Text(this.showPassword ? 'ğŸ™ˆ' : 'ğŸ‘')
                .fontSize(18)
                .fontColor(ArenaTheme.textMuted)
                .padding({ left: 8 })
                .onClick(() => { this.showPassword = !this.showPassword; })
            }
            .width('100%')
            .padding(12)
            .backgroundColor(ArenaTheme.surface)
            .borderRadius(10)
            .border({ width: 1, color: ArenaTheme.border })
          }
          .alignItems(HorizontalAlign.Start)
          .width('100%')

          Button(this.loading ? localeStore.L.loginProcessing : (this.isRegister ? localeStore.L.registerSubmit : localeStore.L.loginSubmit))
            .width('100%')
            .height(48)
            .fontSize(16)
            .fontWeight(FontWeight.Medium)
            .fontColor(Color.White)
            .backgroundColor(ArenaTheme.orangeAccent)
            .borderRadius(10)
            .enabled(!this.loading)
            .onClick(() => { this.submit(); })
        }
        .width('100%')

        Row({ space: 4 }) {
          Text(this.isRegister ? localeStore.L.hasAccount : localeStore.L.noAccount)
            .fontSize(14)
            .fontColor(ArenaTheme.textMuted)
          Text(this.isRegister ? localeStore.L.loginNow : localeStore.L.registerNow)
            .fontSize(14)
            .fontColor(ArenaTheme.orangeAccent)
            .onClick(() => {
              this.isRegister = !this.isRegister;
              this.error = '';
            })
        }

        Row({ space: 4 }) {
          Text('â€¹')
            .fontSize(16)
            .fontColor(ArenaTheme.textMuted)
          Text(localeStore.L.backHome)
            .fontSize(14)
            .fontColor(ArenaTheme.textMuted)
        }
        .margin({ top: 8 })
        .onClick(() => {
          this.pageStack.clear();
        })
      }
      .width('100%')
      .padding(20)
    }
    .width('100%')
    .height('100%')
    .backgroundColor(ArenaTheme.background)
    .scrollBar(BarState.Off)
  }
}
