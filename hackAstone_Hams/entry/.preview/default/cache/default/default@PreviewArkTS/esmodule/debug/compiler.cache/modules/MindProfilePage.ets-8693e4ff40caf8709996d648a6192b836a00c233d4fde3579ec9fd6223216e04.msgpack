//# sourceMappingURL=MindProfilePage.js.mapÂ–ÙZ/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entry/src/main/ets/common/ArenaTheme.etsÙb/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entry/src/main/ets/common/ArenaConfiguration.etsÙU/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entry/src/main/ets/api/ArenaAPI.etsÙX/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entry/src/main/ets/route/AppRoutes.etsÙ[/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entry/src/main/ets/route/GlobalStores.etsÙX/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entry/src/main/ets/store/AuthStore.etsÙ^/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entry/src/main/ets/pages/MindProfilePage.etsÔrB›ªmoduleName±isLocalDependency¯isNodeEntryFile§pkgPath±belongProjectPath§pkgNameªpkgVersion±dependencyPkgInfo¯hostModulesInfo°belongModulePath¬shouldEmitJs¥entryÃÂÙ7/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entryÙ1/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams¥entry¥1.0.0Ô␀␀‘ÔrC’²hostDependencyName®hostModuleName±./MindProfilePage¥entryÙ7/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entryÃÃÚ3Íimport { ArenaTheme } from '../common/ArenaTheme';
import {
  MindProfilePayload,
  MindProfileStat,
  MindProfileBias,
  MindProfileRecentBattle
} from '../common/ArenaModels';
import { ArenaConfiguration } from '../common/ArenaConfiguration';
import { ArenaAPI } from '../api/ArenaAPI';
import { AppRoutes } from '../route/AppRoutes';
import { authStore, localeStore } from '../route/GlobalStores';
import { authSessionDisplayName } from '../store/AuthStore';

@Component
export struct MindProfilePage {
  @Prop pageStack: NavPathStack = new NavPathStack();

  @State data: MindProfilePayload = MindProfilePage.FALLBACK;
  @State loadError: string = '';
  @State loading: boolean = true;
  @State serverAvatarURL: string = '';

  private get profileDisplayName(): string {
    const session = authStore.session;
    if (session === null) {
      return localeStore.L.mindProfileTitle;
    }
    const name = authSessionDisplayName(session).trim();
    return name.length > 0 ? name : localeStore.L.mindProfileTitle;
  }

  aboutToAppear(): void {
    if (authStore.isLoggedIn) {
      this.load();
    } else {
      this.loading = false;
    }
  }

  private async load(): Promise<void> {
    await this.loadUserAvatar();
    this.loading = true;
    try {
      const profile = await ArenaAPI.fetchMindProfile(localeStore.catalogLocale);
      this.data = profile;
      this.loadError = '';
    } catch (e) {
      this.loadError = (e as Error).message ?? String(e);
      this.data = MindProfilePage.EMPTY;
    }
    this.loading = false;
  }

  private async loadUserAvatar(): Promise<void> {
    if (!authStore.isLoggedIn) {
      return;
    }
    try {
      const user = await ArenaAPI.fetchCurrentUser();
      if (user.avatarUrl) {
        this.serverAvatarURL = MindProfilePage.resolveAvatarURL(user.avatarUrl);
      }
    } catch (_e) {
      // ignore
    }
  }

  private static resolveAvatarURL(path: string): string {
    const t = path.trim();
    if (!t) {
      return '';
    }
    if (t.startsWith('http://') || t.startsWith('https://') || t.startsWith('data:')) {
      return t;
    }
    const base = ArenaConfiguration.apiBaseURLString;
    return t.startsWith('/') ? base + t : `${base}/${t}`;
  }

  build() {
    Column() {
      if (!authStore.isLoggedIn) {
        this.guestView();
      } else {
        this.loggedInView();
      }
    }
    .width('100%')
    .height('100%')
    .backgroundColor(ArenaTheme.background)
  }

  @Builder
  guestView() {
    Column({ space: 24 }) {
      Button({ type: ButtonType.Normal }) {
        Row({ space: 4 }) {
          Text('â€¹').fontColor(ArenaTheme.textMuted)
          Text(localeStore.L.backHome).fontColor(ArenaTheme.textMuted)
        }
      }
      .backgroundColor(Color.Transparent)
      .alignSelf(ItemAlign.Start)
      .margin({ left: 16, top: 16 })
      .onClick(() => this.pageStack.clear())

      Blank()
      this.profileAvatar(80)
      Text(localeStore.L.profileGuestTitle)
        .fontSize(28)
        .fontWeight(FontWeight.Bold)
        .fontColor(ArenaTheme.textPrimary)
      Text(localeStore.L.profileGuestHint)
        .fontSize(16)
        .fontColor(ArenaTheme.textMuted)
        .textAlign(TextAlign.Center)
        .padding({ left: 32, right: 32 })
      Button(localeStore.L.profileLoginRegister)
        .width('80%')
        .height(48)
        .fontSize(16)
        .fontWeight(FontWeight.Bold)
        .fontColor(Color.White)
        .backgroundColor(ArenaTheme.orangeAccent)
        .borderRadius(12)
        .onClick(() => {
          this.pageStack.pushPath({ name: AppRoutes.login() });
        })
      Blank()
    }
    .width('100%')
    .height('100%')
  }

  @Builder
  loggedInView() {
    Scroll() {
      Column({ space: 24 }) {
        Column({ space: 12 }) {
          Button({ type: ButtonType.Normal }) {
            Row({ space: 4 }) {
              Text('â€¹').fontColor(ArenaTheme.textMuted)
              Text(localeStore.L.backHome).fontColor(ArenaTheme.textMuted)
            }
          }
          .backgroundColor(Color.Transparent)
          .alignSelf(ItemAlign.Start)
          .onClick(() => this.pageStack.clear())

          this.profileAvatar(72)
          Text(localeStore.L.mindProfileTitle)
            .fontSize(32)
            .fontWeight(FontWeight.Bold)
            .fontColor(ArenaTheme.textPrimary)
          Text(localeStore.L.mindProfileSubtitle)
            .fontColor(ArenaTheme.textMuted)
          if (authStore.session !== null) {
            Text(authSessionDisplayName(authStore.session))
              .fontSize(14)
              .fontColor(ArenaTheme.orangeAccent)
          }
          if (this.loadError) {
            Text(this.loadError)
              .fontSize(12)
              .fontColor(ArenaTheme.orangeAccent)
          }
        }
        .width('100%')
        .alignItems(HorizontalAlign.Center)

        if (this.loading) {
          LoadingProgress()
            .color(ArenaTheme.orangeAccent)
            .width(40)
            .height(40)
            .margin({ top: 40, bottom: 40 })
        } else {
          this.statsGrid()
          this.biasesSection()
          this.insightsSection()
          this.recentSection()
          this.cta()
        }
      }
      .padding({ left: 16, right: 16, bottom: 32 })
      .width('100%')
    }
    .layoutWeight(1)
  }

  @Builder
  profileAvatar(size: number) {
    Stack() {
      Column()
        .width(size)
        .height(size)
        .borderRadius(size / 2)
        .linearGradient({
          angle: 135,
          colors: [[ArenaTheme.orangeAccent, 0], ['#DC2626D9', 1]]
        })
      if (this.serverAvatarURL) {
        Image(this.serverAvatarURL)
          .width(size)
          .height(size)
          .borderRadius(size / 2)
          .objectFit(ImageFit.Cover)
      } else {
        Text(this.profileDisplayName.substring(0, 1).toUpperCase())
          .fontSize(size * 0.38)
          .fontWeight(FontWeight.Bold)
          .fontColor(Color.White)
      }
    }
    .width(size)
    .height(size)
  }

  @Builder
  statsGrid() {
    Flex({ wrap: FlexWrap.Wrap, justifyContent: FlexAlign.Start }) {
      ForEach(this.data.stats, (s: MindProfileStat, idx: number) => {
        Column({ space: 10 }) {
          Text('ğŸ‘¥')
            .fontSize(22)
            .fontColor(ArenaTheme.orangeAccent)
          Text(s.value)
            .fontSize(28)
            .fontWeight(FontWeight.Bold)
            .fontColor(ArenaTheme.textPrimary)
          Text(localeStore.L.localizeMindStatLabel(s.label))
            .fontSize(12)
            .fontColor(ArenaTheme.textMuted)
        }
        .padding(18)
        .width('46%')
        .margin({ right: 8, bottom: 12 })
        .backgroundColor(ArenaTheme.surface)
        .border({ width: 1, color: ArenaTheme.border, radius: 14 })
      }, (s: MindProfileStat, idx: number) => `${idx}-${s.label}`)
    }
    .width('100%')
  }

  @Builder
  biasesSection() {
    Column({ space: 12 }) {
      Text(localeStore.L.biasMapTitle)
        .fontSize(22)
        .fontWeight(FontWeight.Bold)
        .fontColor(ArenaTheme.textPrimary)
      Text(localeStore.L.biasMapFootnote)
        .fontSize(12)
        .fontColor(ArenaTheme.textMuted)
      if (this.data.biases.length === 0) {
        Text(localeStore.L.prefersEnglish
          ? 'Complete debates while logged in to build your bias map.'
          : 'ç™»å½•åå®Œæˆè¾©è®ºï¼Œå³å¯ç”Ÿæˆä½ çš„åå·®åœ°å›¾ã€‚')
          .fontSize(12)
          .fontColor(ArenaTheme.textMuted)
      } else {
        ForEach(this.data.biases, (bias: MindProfileBias, idx: number) => {
          Column({ space: 6 }) {
            Row() {
              Text(bias.name).fontSize(16).fontWeight(FontWeight.Bold).fontColor(ArenaTheme.textPrimary)
              Blank()
              Text(`${bias.percentage}%`)
                .fontSize(16)
                .fontWeight(FontWeight.Bold)
                .fontColor(ArenaTheme.orangeAccent)
            }
            .width('100%')
            Text(bias.description).fontSize(12).fontColor(ArenaTheme.textMuted)
            Text(localeStore.L.occurrences(bias.instances)).fontSize(11).fontColor(ArenaTheme.textMuted)
          }
          .padding(14)
          .width('100%')
          .backgroundColor(ArenaTheme.surface)
          .border({ width: 1, color: ArenaTheme.border, radius: 12 })
        }, (bias: MindProfileBias, idx: number) => `${idx}-${bias.name}`)
      }
    }
    .alignItems(HorizontalAlign.Start)
    .width('100%')
  }

  @Builder
  insightsSection() {
    Column({ space: 12 }) {
      Text(localeStore.L.keyInsights)
        .fontSize(22)
        .fontWeight(FontWeight.Bold)
        .fontColor(ArenaTheme.textPrimary)
      Column({ space: 8 }) {
        Text(localeStore.L.insightWatchOutTitle)
          .fontSize(16)
          .fontWeight(FontWeight.Bold)
          .fontColor('#EF4444E6')
        Text(localeStore.L.insightWatchOutBody).fontSize(12).fontColor(ArenaTheme.textMuted)
      }
      .padding(14)
      .width('100%')
      .backgroundColor(ArenaTheme.surface)
      .border({ width: 1, color: ArenaTheme.border, radius: 12 })

      Column({ space: 8 }) {
        Text(localeStore.L.insightStrengthTitle)
          .fontSize(16)
          .fontWeight(FontWeight.Bold)
          .fontColor(ArenaTheme.cyanAccent)
        Text(localeStore.L.insightStrengthBody).fontSize(12).fontColor(ArenaTheme.textMuted)
      }
      .padding(14)
      .width('100%')
      .backgroundColor(ArenaTheme.surface)
      .border({ width: 1, color: ArenaTheme.border, radius: 12 })
    }
    .alignItems(HorizontalAlign.Start)
    .width('100%')
  }

  @Builder
  recentSection() {
    Column({ space: 12 }) {
      Text(localeStore.L.recentThoughts)
        .fontSize(22)
        .fontWeight(FontWeight.Bold)
        .fontColor(ArenaTheme.textPrimary)
      if (this.data.recentBattles.length === 0) {
        Text(localeStore.L.prefersEnglish ? 'No recent matches yet.' : 'æš‚æ— è¿‘æœŸå¯¹å±€è®°å½•ã€‚')
          .fontSize(12)
          .fontColor(ArenaTheme.textMuted)
      } else {
        ForEach(this.data.recentBattles, (b: MindProfileRecentBattle, idx: number) => {
          Column({ space: 8 }) {
            Text(b.question).fontSize(16).fontWeight(FontWeight.Bold).fontColor(ArenaTheme.textPrimary)
            if (b.changed) {
              Text(localeStore.L.stanceChanged).fontSize(11).fontColor(ArenaTheme.orangeAccent)
            }
            Row() {
              Column({ space: 4 }) {
                Text(localeStore.L.yourPick).fontSize(11).fontColor(ArenaTheme.textMuted)
                Text(localeStore.L.localizeRecentChoice(b.choice)).fontSize(12)
              }
              .alignItems(HorizontalAlign.Start)
              .layoutWeight(1)
              Column({ space: 4 }) {
                Text(localeStore.L.judgeFollowUpShort).fontSize(11).fontColor(ArenaTheme.textMuted)
                Text(b.judgeComment).fontSize(12)
              }
              .alignItems(HorizontalAlign.Start)
              .layoutWeight(1)
            }
            .width('100%')
            .alignItems(VerticalAlign.Top)
          }
          .padding(14)
          .width('100%')
          .backgroundColor(ArenaTheme.surface)
          .border({ width: 1, color: ArenaTheme.border, radius: 12 })
        }, (b: MindProfileRecentBattle, idx: number) => `${idx}-${b.question}`)
      }
    }
    .alignItems(HorizontalAlign.Start)
    .width('100%')
  }

  @Builder
  cta() {
    Column({ space: 12 }) {
      Text(localeStore.L.growthQuote)
        .fontSize(12)
        .fontStyle(FontStyle.Italic)
        .fontColor(ArenaTheme.textMuted)
        .textAlign(TextAlign.Center)
      Row({ space: 12 }) {
        Button(localeStore.L.philosophyDebate)
          .layoutWeight(1)
          .height(48)
          .fontColor(Color.White)
          .backgroundColor(ArenaTheme.purpleAccent)
          .borderRadius(12)
          .onClick(() => this.pageStack.clear())
        Button(localeStore.L.disciplinesDebate)
          .layoutWeight(1)
          .height(48)
          .fontColor(Color.White)
          .backgroundColor(ArenaTheme.orangeAccent)
          .borderRadius(12)
          .onClick(() => {
            this.pageStack.clear();
            this.pageStack.pushPath({ name: AppRoutes.disciplines() });
          })
      }
      .width('100%')
    }
    .padding({ top: 8 })
    .width('100%')
  }

  private static readonly EMPTY: MindProfilePayload = {
    biases: [],
    stats: [
      { label: 'å·²å®Œæˆå¯¹å±€', value: '0' },
      { label: 'æ”¹å˜ç«‹åœºæ¬¡æ•°', value: '0' },
      { label: 'æ€ç»´ç›²åŒº', value: '0' },
