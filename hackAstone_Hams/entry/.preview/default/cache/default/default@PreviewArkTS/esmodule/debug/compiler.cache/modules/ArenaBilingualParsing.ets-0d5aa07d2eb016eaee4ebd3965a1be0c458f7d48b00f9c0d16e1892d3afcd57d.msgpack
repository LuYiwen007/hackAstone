    }
    const o = raw as Record<string, Object>;
    const pr = ArenaBilingualParsing.str(o['philosopherReply']);
    const jq = ArenaBilingualParsing.str(o['judgeQuestion']);
    if (pr.length === 0 || jq.length === 0) {
