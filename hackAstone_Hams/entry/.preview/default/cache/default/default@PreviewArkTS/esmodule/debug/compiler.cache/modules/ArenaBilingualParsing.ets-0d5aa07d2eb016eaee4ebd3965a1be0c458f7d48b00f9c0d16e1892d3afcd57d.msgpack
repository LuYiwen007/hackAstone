  private static normalizeBattleSlice(raw: Object | null | undefined): BattleLocaleSlice | null {
    if (raw === undefined || raw === null || typeof raw !== 'object' || Array.isArray(raw)) {
      return null;
    }
    const o = raw as Record<string, Object>;
