//# sourceMappingURL=DebateSummarySection.js.mapÂ–ÙZ/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entry/src/main/ets/common/ArenaTheme.etsÙ[/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entry/src/main/ets/route/GlobalStores.etsÙ[/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entry/src/main/ets/common/ArenaModels.etsÙe/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entry/src/main/ets/common/ArenaBilingualParsing.etsÙ[/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entry/src/main/ets/common/JsonPayload.etsÙU/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entry/src/main/ets/api/ArenaAPI.etsÙh/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entry/src/main/ets/components/DebateSummarySection.etsÔrB›ªmoduleName±isLocalDependency¯isNodeEntryFile§pkgPath±belongProjectPath§pkgNameªpkgVersion±dependencyPkgInfo¯hostModulesInfo°belongModulePath¬shouldEmitJs¥entryÃÂÙ7/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entryÙ1/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams¥entry¥1.0.0Ô␀␀‘ÔrC’²hostDependencyName®hostModuleNameÙ"../components/DebateSummarySection¥entryÙ7/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entryÃÃÚ#©import { ArenaTheme } from '../common/ArenaTheme';
import { authStore, localeStore } from '../route/GlobalStores';
import { Philosopher, PhilosopherData, PhilosophyChoice, philosopherDisplayName } from '../common/ArenaModels';
import { ArenaBilingualParsing } from '../common/ArenaBilingualParsing';
import { JsonPayload } from '../common/JsonPayload';
import { ArenaAPI } from '../api/ArenaAPI';

interface InsightComparison {
  philosopherStance: string;
  userStance: string;
  alignment: string;
}

interface AiDebateInsight {
  corePoints: string[];
  comparison: InsightComparison;
  deepQuestions: string[];
}

/** å¯¹é½ Web `DebateSummary`ï¼šEcho æ™ºèƒ½æ€»ç»“ + æŒ‰ç”¨æˆ· uid ä¿å­˜ç¬”è®°ã€‚ */
@Component
export struct DebateSummarySection {
  @Prop philosopher: Philosopher = new PhilosopherData();
  @Prop question: string = '';
  @Prop userChoice: PhilosophyChoice | null = null;
  @Prop userReason: string = '';
  @Prop sourceType: string = 'debate';

  @State insight: AiDebateInsight | null = null;
  @State isLoading: boolean = true;
  @State loadError: string = '';
  @State notes: string = '';
  @State showNotes: boolean = false;
  @State noteSaving: boolean = false;
  @State noteMessage: string = '';

  private sourceKey(): string {
    return ArenaBilingualParsing.buildDebateNoteKey(this.philosopher.id, this.question);
  }

  aboutToAppear(): void {
    this.loadInsight();
    this.loadNote();
  }

  private buildInsightPrompt(): string {
    let choiceLabel = '';
    switch (this.userChoice) {
      case PhilosophyChoice.AGREE:
        choiceLabel = localeStore.L.prefersEnglish ? 'Agree with philosopher' : 'åŒæ„å“²å­¦å®¶ç«‹åœº';
        break;
      case PhilosophyChoice.DISAGREE:
        choiceLabel = localeStore.L.prefersEnglish ? 'Oppose philosopher' : 'åå¯¹å“²å­¦å®¶ç«‹åœº';
        break;
      case PhilosophyChoice.UNCERTAIN:
        choiceLabel = localeStore.L.prefersEnglish ? 'Uncertain' : 'ä¸ç¡®å®š';
        break;
      default:
        choiceLabel = localeStore.L.prefersEnglish ? 'Not selected' : 'æœªé€‰æ‹©';
    }
    const ideas = this.philosopher.keyIdeas.join('ã€');
    const reason = this.userReason.length > 0
      ? this.userReason
      : (localeStore.L.prefersEnglish ? '(No user text)' : 'ï¼ˆç”¨æˆ·æœªç•™ä¸‹æ–‡å­—ï¼‰');
    return `[ROLE]
CA-Echo-LLM

[TASK]
æ ¹æ®ä¸€åœºå“²å­¦è¾©è®ºçš„ä¿¡æ¯ï¼Œç”Ÿæˆç»“æ„åŒ–ã€Œæ™ºèƒ½æ€»ç»“ã€ï¼Œä»…è¿”å› JSONã€‚

[RETURN_FORMAT]
{"corePoints":["..."],"comparison":{"philosopherStance":"...","userStance":"...","alignment":"..."},"deepQuestions":["..."]}

[CONSTRAINTS]
ä¸­æ–‡ï¼›corePoints è‡³å°‘ 3 æ¡ï¼›deepQuestions è‡³å°‘ 3 æ¡ï¼›comparison.userStance åº”æ¦‚æ‹¬ç”¨æˆ·ç†ç”±ï¼›ä»…è¿”å› JSONã€‚

å“²å­¦å®¶ï¼š${this.philosopher.nameCN}ï¼›å­¦æ´¾ï¼š${this.philosopher.school}ï¼›å…³é”®æ€æƒ³ï¼š${ideas}
è¾©é¢˜ï¼š${this.question}
ç”¨æˆ·ç«‹åœºæ ‡ç­¾ï¼š${choiceLabel}
ç”¨æˆ·é™ˆè¿°ä¸ç†ç”±ï¼š${reason}`;
  }

  private async loadInsight(): Promise<void> {
    this.isLoading = true;
    this.loadError = '';
    this.insight = null;
    try {
      const resp = await ArenaAPI.runEcho(this.buildInsightPrompt());
      const parsed = JsonPayload.parse<AiDebateInsight>(resp.text);
      if (!parsed || !parsed.corePoints || parsed.corePoints.length === 0 ||
        !parsed.deepQuestions || parsed.deepQuestions.length === 0) {
        throw new Error(localeStore.L.topicBadJson);
      }
      this.insight = parsed;
    } catch (e) {
      this.loadError = e instanceof Error ? e.message : String(e);
    } finally {
      this.isLoading = false;
    }
  }

  private async loadNote(): Promise<void> {
    if (!authStore.isLoggedIn) {
      this.notes = '';
      return;
    }
    try {
      const content = await ArenaAPI.fetchDebateNote(this.sourceType, this.sourceKey());
      if (content) {
        this.notes = content;
      }
    } catch (_e) {
      // æ— ç¬”è®°æ—¶å¿½ç•¥
    }
  }

  private async saveNote(): Promise<void> {
    if (!authStore.isLoggedIn) {
      return;
    }
    this.noteSaving = true;
    this.noteMessage = '';
    try {
      await ArenaAPI.saveDebateNote(this.sourceType, this.sourceKey(), this.question, this.notes);
      this.noteMessage = localeStore.L.noteSaved;
    } catch (e) {
      this.noteMessage = e instanceof Error ? e.message : String(e);
    } finally {
      this.noteSaving = false;
    }
  }

  @Builder
  insightContent(s: AiDebateInsight, name: string) {
    Column({ space: 16 }) {
      Column({ space: 8 }) {
        Text(localeStore.L.corePoints)
          .fontSize(16)
          .fontWeight(FontWeight.Bold)
          .fontColor(ArenaTheme.textPrimary)
        ForEach(s.corePoints, (p: string, idx: number) => {
          Text(`â€¢ ${p}`)
            .fontSize(14)
            .fontColor('#D1D5DB')
        }, (_p: string, idx: number) => `cp-${idx}`)
      }
      .alignItems(HorizontalAlign.Start)
      .width('100%')

      Column({ space: 10 }) {
        Text(localeStore.L.stanceCompare)
          .fontSize(16)
          .fontWeight(FontWeight.Bold)
          .fontColor(ArenaTheme.textPrimary)
        Text(localeStore.L.philosopherStanceLabel(name))
          .fontSize(14)
          .fontWeight(FontWeight.Medium)
          .fontColor(ArenaTheme.textPrimary)
        Text(s.comparison.philosopherStance)
          .fontSize(14)
          .fontColor(ArenaTheme.textMuted)
        Text(localeStore.L.yourStanceLabel)
          .fontSize(14)
          .fontWeight(FontWeight.Medium)
          .fontColor(ArenaTheme.textPrimary)
          .margin({ top: 4 })
        Text(s.comparison.userStance)
          .fontSize(14)
          .fontColor(ArenaTheme.textMuted)
        Text(localeStore.L.alignmentLabel(s.comparison.alignment))
          .fontSize(14)
          .fontColor(ArenaTheme.cyanAccent)
          .margin({ top: 4 })
      }
      .alignItems(HorizontalAlign.Start)
      .width('100%')

      Column({ space: 8 }) {
        Text(localeStore.L.deepQuestions)
          .fontSize(16)
          .fontWeight(FontWeight.Bold)
          .fontColor(ArenaTheme.textPrimary)
        ForEach(s.deepQuestions, (q: string, idx: number) => {
          Text(`${idx + 1}. ${q}`)
            .fontSize(14)
            .fontColor('#D1D5DB')
        }, (_q: string, idx: number) => `dq-${idx}`)
      }
      .alignItems(HorizontalAlign.Start)
      .width('100%')
    }
    .alignItems(HorizontalAlign.Start)
    .width('100%')
  }

  private displayPhilosopherName(): string {
    return philosopherDisplayName(this.philosopher, localeStore.L.prefersEnglish);
  }

  build() {
    Column({ space: 16 }) {
      Row({ space: 8 }) {
        Text('ğŸ’¡')
          .fontSize(18)
        Text(localeStore.L.debateSummaryTitle)
          .fontSize(18)
          .fontWeight(FontWeight.Bold)
          .fontColor(ArenaTheme.textPrimary)
      }

      if (this.isLoading) {
        Text(localeStore.L.topicGenerating)
          .fontSize(12)
          .fontColor(ArenaTheme.textMuted)
      } else if (this.loadError.length > 0) {
        Text(this.loadError)
          .fontSize(12)
          .fontColor('#E57373')
      } else if (this.insight) {
        this.insightContent(this.insight, this.displayPhilosopherName());
      }

      Column({ space: 10 }) {
        Row() {
          Row({ space: 8 }) {
            Text('ğŸ“')
              .fontSize(16)
            Text(localeStore.L.personalNotes)
              .fontSize(16)
              .fontWeight(FontWeight.Medium)
              .fontColor(ArenaTheme.textPrimary)
          }
          Blank()
          Text(this.showNotes ? 'â–¼' : 'â–¶')
            .fontSize(12)
            .fontColor(ArenaTheme.textMuted)
        }
        .width('100%')
        .onClick(() => {
          this.showNotes = !this.showNotes;
        })

        if (this.showNotes) {
          TextArea({ text: this.notes, placeholder: localeStore.L.notesPlaceholder })
            .fontColor(ArenaTheme.textPrimary)
            .backgroundColor(ArenaTheme.background)
            .height(120)
            .borderRadius(10)
            .border({ width: 1, color: ArenaTheme.border })
            .onChange((v: string) => {
              this.notes = v;
            })

          Button(this.noteSaving ? localeStore.L.savingNote : (authStore.isLoggedIn ? localeStore.L.saveNote : localeStore.L.loginToSaveNote))
            .width('100%')
            .height(44)
            .fontSize(14)
            .fontWeight(FontWeight.Medium)
            .fontColor(Color.White)
            .backgroundColor(ArenaTheme.purpleAccent)
            .borderRadius(10)
            .enabled(!this.noteSaving && authStore.isLoggedIn)
            .onClick(() => {
              this.saveNote();
            })

          if (this.noteMessage.length > 0) {
            Text(this.noteMessage)
              .fontSize(12)
              .fontColor(ArenaTheme.textMuted)
          }
        }
      }
      .alignItems(HorizontalAlign.Start)
      .width('100%')
    }
    .width('100%')
    .padding(16)
    .backgroundColor(ArenaTheme.surface)
    .borderRadius(14)
    .border({ width: 1, color: ArenaTheme.border })
    .margin({ top: 8 })
  }
}
