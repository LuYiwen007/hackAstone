    messageLabel(role, philosopher) {
        if (role === 'user') {
            return localeStore.L.you;
        }
        if (role === 'philosopher') {
            return philosopherDisplayName(philosopher, localeStore.L.prefersEnglish);
        }
        return localeStore.L.judge;
    }
    messageBorder(role) {
        if (role === 'user') {
            return '#A855F799';
        }
        if (role === 'judge') {
            return '#FACC1573';
        }
        return ArenaTheme.border;
    }
    messageBg(role) {
        if (role === 'user') {
            return '#A855F71F';
        }
        if (role === 'judge') {
            return '#FACC1514';
        }
        return ArenaTheme.surface;
    }
    recordMessageRole(m) {
        if (m.role === 'user') {
            return 'user';
        }
        if (m.role === 'philosopher') {
            return 'philosopher';
        }
        return 'judge';
    }
    toRecordMessage(m) {
        const out = {};
        out['role'] = this.recordMessageRole(m);
        out['content'] = m.content;
        return out;
    }
    handleChoose(c) {
        this.choice = c;
        this.stage = 'debate';
        this.canReveal = false;
        this.messages = [
            new PBMessage(`${Date.now()}`, 'judge', localeStore.L.judgeOpeningAfterChoice(localeStore.L.choiceDisplay(c)))
        ];
    }
    async loadTopic(philosopher) {
        this.isTopicLoading = true;
        this.topicLoadError = '';
        try {
            const resp = await ArenaAPI.generateTopic(philosopher.nameCN, philosopher.school, philosopher.keyIdeas, localeStore.L.prefersEnglish ? 'en' : 'zh');
            const parsed = resp.debateTopic ?? JsonPayload.parse(resp.text);
            if (parsed && parsed.question && parsed.philosopherView && parsed.oppositeView) {
                this.topic = parsed;
                this.fullExplanation = parsed.fullExplanation ?? '';
                this.topicLoadError = '';
            }
            else {
                throw new Error(localeStore.L.topicBadJson);
            }
        }
        catch (e) {
            this.topic = null;
            this.topicLoadError = e.message ?? String(e);
        }
        this.isTopicLoading = false;
    }
    choiceLabel(c) {
        return c;
    }
    historyBlock(msgs, philosopher) {
        const top = this.topic;
        const lines = msgs.map((m) => {
            let who = localeStore.L.user;
            if (m.role === 'judge') {
                who = localeStore.L.judge;
            }
            else if (m.role === 'philosopher') {
                who = philosopherDisplayName(philosopher, localeStore.L.prefersEnglish);
            }
            return `${who}ï¼š${m.content}`;
        }).join('\n');
        return `è¾©é¢˜ï¼š${top.question}\nå“²å­¦å®¶ï¼š${philosopher.nameCN}ï¼ˆ${philosopher.school}ï¼‰\nç”¨æˆ·ç«‹åœºï¼š${this.choiceLabel(this.choice)}\nå†å²ï¼š\n${lines}`;
    }
    async handleUserTurn(philosopher) {
        const content = this.userInput.trim();
        if (!content || !this.choice || !this.topic || this.isThinking) {
            return;
        }
        const userRowId = `${Date.now()}-user`;
        this.userInput = '';
        this.isThinking = true;
        const userMsg = new PBMessage(userRowId, 'user', content);
        let next = this.messages.concat([userMsg]);
        this.messages = next;
        const localeCode = localeStore.L.prefersEnglish ? 'en' : 'zh';
        const keyIdeas = philosopher.keyIdeas.join('ã€‚');
        const summary = philosopher.summary ?? '';
        const userStance = this.choiceLabel(this.choice);
        const streamPhilosopher = async (mode, prior) => {
            const msgId = `${mode}-${Date.now()}`;
            let row = new PBMessage(msgId, 'philosopher', '');
            this.thinkingRole = 'philosopher';
            this.messages = prior.concat([row]);
            const hist = this.historyBlock(prior, philosopher);
            const onDelta = (_d, acc) => {
                row = new PBMessage(msgId, 'philosopher', streamDisplay(acc));
                this.messages = prior.concat([row]);
            };
            const resp = mode === 'to-user'
                ? await ArenaAPI.streamPhilosophyPhilosopherToUser(this.topic.question, philosopher.id, philosopherDisplayName(philosopher, localeStore.L.prefersEnglish), philosopher.school, keyIdeas, summary, userStance, hist, localeCode, onDelta)
                : await ArenaAPI.streamPhilosophyPhilosopherToJudge(this.topic.question, philosopher.id, philosopherDisplayName(philosopher, localeStore.L.prefersEnglish), philosopher.school, keyIdeas, summary, userStance, hist, localeCode, onDelta);
            const final = streamDisplay(resp.text);
            if (!final) {
                throw new Error('empty response');
            }
            const done = new PBMessage(msgId, 'philosopher', final);
            this.messages = prior.concat([done]);
            return done;
        };
        const streamJudge = async (prior) => {
            const msgId = `judge-${Date.now()}`;
            let row = new PBMessage(msgId, 'judge', '');
            this.thinkingRole = 'judge';
            this.messages = prior.concat([row]);
            const hist = this.historyBlock(prior, philosopher);
            const onDelta = (_d, acc) => {
                row = new PBMessage(msgId, 'judge', judgeStreamDisplay(acc));
                this.messages = prior.concat([row]);
            };
            const resp = await ArenaAPI.streamPhilosophyJudgeStep(this.topic.question, philosopherDisplayName(philosopher, localeStore.L.prefersEnglish), philosopher.school, userStance, hist, localeCode, onDelta);
            if (!resp.philosophyJudge) {
                throw new Error(localeStore.L.topicBadJson);
            }
            const judge = new JudgeStepResult(resp.philosophyJudge.judgeSpeaks, resp.philosophyJudge.judgeMessage, resp.philosophyJudge.addressTo ?? null, resp.philosophyJudge.continueDebate);
            if (judge.judgeSpeaks && judge.judgeMessage.length > 0) {
                const final = judgeStreamDisplay(resp.text).length === 0 ? judge.judgeMessage : judgeStreamDisplay(resp.text);
                const done = new PBMessage(msgId, 'judge', final);
                this.messages = prior.concat([done]);
                return new JudgeStreamOutcome(judge, done);
            }
            this.messages = prior;
            return new JudgeStreamOutcome(judge, null);
        };
        try {
            const philToUser = await streamPhilosopher('to-user', next);
            let working = next.concat([philToUser]);
            const judgeResult = await streamJudge(working);
            if (judgeResult.judgeMsg) {
                working = working.concat([judgeResult.judgeMsg]);
            }
            if (judgeResult.judge.judgeSpeaks && judgeResult.judge.addressTo === 'philosopher') {
                const philToJudge = await streamPhilosopher('to-judge', working);
                working = working.concat([philToJudge]);
                this.messages = working;
            }
            this.canReveal = judgeResult.judge.continueDebate === false;
        }
        catch (e) {
            this.messages = this.messages.filter((m) => m.id !== userRowId);
            this.userInput = content;
            this.errorAlert = e.message ?? String(e);
            this.showErrorDialog = true;
        }
        this.isThinking = false;
        this.thinkingRole = null;
    }
    async handleReveal(philosopher) {
        if (!this.choice || !this.topic) {
            return;
        }
        this.stage = 'reveal';
        this.isGeneratingSummary = true;
        this.fullExplanation = '';
        const history = this.messages.map((m) => {
            let who = localeStore.L.user;
            if (m.role === 'judge') {
                who = localeStore.L.judge;
            }
            else if (m.role === 'philosopher') {
                who = philosopherDisplayName(philosopher, localeStore.L.prefersEnglish);
            }
            return `${who}ï¼š${m.content}`;
        }).join('\n');
        const summaryQuery = `[ROLE]\nCA-Echo-LLM\n\n[TASK]\næ ¹æ®è¾©è®ºå†å²ç”Ÿæˆå®Œæ•´æ€»ç»“è§£é‡Šã€‚\n\n[RETURN_FORMAT]\njson\n\n[CONSTRAINTS]\nä¸­æ–‡ï¼›ä»…è¿”å› JSONï¼›å†…å®¹æœ‰å±‚æ¬¡\n\n[ACCEPTANCE_CRITERIA]\nè¿”å› fullExplanation å­—æ®µ\n\nè¾©é¢˜ï¼š${this.topic.question}\nå“²å­¦å®¶ï¼š${philosopher.nameCN}\nç”¨æˆ·ç«‹åœºï¼š${this.choiceLabel(this.choice)}\nå†å²ï¼š\n${history}`;
        try {
            const resp = await ArenaAPI.runEcho(summaryQuery);
            const parsed = JsonPayload.parse(resp.text);
            if (parsed?.fullExplanation && parsed.fullExplanation.length > 0) {
                this.fullExplanation = parsed.fullExplanation;
                if (AuthStore.bearerToken && this.topic) {
                    const choiceText = localeStore.L.choiceDisplay(this.choice);
                    ArenaAPI.saveBattleRecord('philosophy', this.topic.question, choiceText, parsed.fullExplanation, false, this.messages.map((m) => this.toRecordMessage(m))).catch(() => { });
                }
            }
            else {
                this.errorAlert = localeStore.L.topicBadJson;
                this.showErrorDialog = true;
            }
        }
        catch (e) {
            this.errorAlert = e.message ?? String(e);
            this.showErrorDialog = true;
        }
        this.isGeneratingSummary = false;
    }
    rerender() {
        this.updateDirtyElements();
    }
}
//# sourceMappingURL=PhilosophyBattlePage.js.mapÂ˜ÙZ/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entry/src/main/ets/common/ArenaTheme.etsÙW/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entry/src/main/ets/l10n/ArenaL10n.etsÙ[/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entry/src/main/ets/common/JsonPayload.etsÙU/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entry/src/main/ets/api/ArenaAPI.etsÙX/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entry/src/main/ets/route/AppRoutes.etsÙ[/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entry/src/main/ets/route/GlobalStores.etsÙX/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entry/src/main/ets/store/AuthStore.etsÙh/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entry/src/main/ets/components/DebateSummarySection.etsÙc/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entry/src/main/ets/pages/PhilosophyBattlePage.etsÔrB›ªmoduleName±isLocalDependency¯isNodeEntryFile§pkgPath±belongProjectPath§pkgNameªpkgVersion±dependencyPkgInfo¯hostModulesInfo°belongModulePath¬shouldEmitJs¥entryÃÂÙ7/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entryÙ1/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams¥entry¥1.0.0Ô␀␀‘ÔrC’²hostDependencyName®hostModuleName¶./PhilosophyBattlePage¥entryÙ7/Users/luyiwen/Desktop/hackAstone/hackAstone_Hams/entryÃÃÚ^ÿimport { ArenaTheme } from '../common/ArenaTheme';
import { DebateTopicContent, Philosopher } from '../common/ArenaModels';
import { PhilosophyChoice, philosopherDisplayName } from '../l10n/ArenaL10n';
import { JsonPayload } from '../common/JsonPayload';
import { ArenaAPI } from '../api/ArenaAPI';
import { AppRoutes } from '../route/AppRoutes';
import { catalogStore, localeStore } from '../route/GlobalStores';
import { AuthStore } from '../store/AuthStore';
import { DebateSummarySection } from '../components/DebateSummarySection';

type PBStage = 'topic' | 'choose' | 'debate' | 'reveal';
type PBMessageRole = 'user' | 'philosopher' | 'judge';
type PBThinkingRole = 'philosopher' | 'judge';

class PBMessage {
  id: string = '';
  role: PBMessageRole = 'user';
  content: string = '';

  constructor(id: string, role: PBMessageRole, content: string) {
    this.id = id;
    this.role = role;
    this.content = content;
  }

  withContent(nextContent: string): PBMessage {
    return new PBMessage(this.id, this.role, nextContent);
  }
}

class JudgeStepResult {
  judgeSpeaks: boolean = false;
  judgeMessage: string = '';
  addressTo: string | null = null;
  continueDebate: boolean = true;

  constructor(
    judgeSpeaks: boolean,
    judgeMessage: string,
    addressTo: string | null,
    continueDebate: boolean
  ) {
    this.judgeSpeaks = judgeSpeaks;
    this.judgeMessage = judgeMessage;
    this.addressTo = addressTo;
    this.continueDebate = continueDebate;
  }
}

class JudgeStreamOutcome {
  judge: JudgeStepResult;
  judgeMsg: PBMessage | null;

  constructor(judge: JudgeStepResult, judgeMsg: PBMessage | null) {
    this.judge = judge;
    this.judgeMsg = judgeMsg;
  }
}

interface RTContentPayload {
  content?: string;
}

interface SummaryOnly {
  fullExplanation?: string;
}

function streamDisplay(acc: string): string {
  const trimmed = acc.trim();
  const parsed = JsonPayload.parse<RTContentPayload>(trimmed);
  if (parsed?.content && parsed.content.length > 0) {
    return parsed.content;
  }
  const match = trimmed.match(/"content"\s*:\s*"/);
  if (match && match.index !== undefined) {
    let tail = trimmed.substring(match.index + match[0].length);
    const end = tail.indexOf('"');
    if (end >= 0) {
      tail = tail.substring(0, end);
    }
    return tail.replace(/\\n/g, '\n').replace(/\\"/g, '"');
  }
  return trimmed;
}

function judgeStreamDisplay(acc: string): string {
  let s = acc;
  const metaIdx = s.lastIndexOf('\nMETA:');
  if (metaIdx >= 0) {
    s = s.substring(0, metaIdx);
  } else if (s.startsWith('META:')) {
    s = '';
  }
  s = s.trim();
  if (s === '[NO_JUDGE]' || s.startsWith('[NO_JUDGE]')) {
    return '';
  }
  return s;
}

@Component
export struct PhilosophyBattlePage {
  @Prop pageStack: NavPathStack = new NavPathStack();
  @Prop philosopherId: string = '';

  @State stage: PBStage = 'topic';
  @State choice: PhilosophyChoice | null = null;
  @State topic: DebateTopicContent | null = null;
  @State topicLoadError: string = '';
  @State isTopicLoading: boolean = false;
  @State topicRetryNonce: number = 0;
  @State messages: PBMessage[] = [];
  @State userInput: string = '';
  @State isThinking: boolean = false;
  @State thinkingRole: PBThinkingRole | null = null;
  @State canReveal: boolean = false;
  @State fullExplanation: string = '';
  @State isGeneratingSummary: boolean = false;
  @State errorAlert: string = '';
  @State showErrorDialog: boolean = false;
  scroller: Scroller = new Scroller();

  private get philosopher(): Philosopher | undefined {
    return catalogStore.philosophers.find((p: Philosopher) => p.id === this.philosopherId);
  }

  aboutToAppear(): void {
    const p = this.philosopher;
    if (p) {
      this.loadTopic(p);
    }
  }

  build() {
    Column() {
      if (this.philosopher) {
        Scroll(this.scroller) {
          Column({ space: 20 }) {
            this.battleHeader(this.philosopher!);
            this.content(this.philosopher!);
          }
          .padding({ left: 16, right: 16, bottom: 32, top: 16 })
          .width('100%')
        }
        .layoutWeight(1)
      } else {
        this.missing();
      }
    }
    .width('100%')
    .height('100%')
    .backgroundColor(ArenaTheme.background)
    .bindContentCover(this.showErrorDialog, this.errorDialog(), {
      modalTransition: ModalTransition.DEFAULT,
      onDisappear: () => { this.showErrorDialog = false; }
    })
  }

  @Builder
  errorDialog() {
    Column({ space: 16 }) {
      Text(localeStore.L.apiRequestFailedTitle).fontSize(18).fontWeight(FontWeight.Bold)
      Text(this.errorAlert).fontSize(14)
      Button(localeStore.L.alertConfirm)
        .onClick(() => {
          this.showErrorDialog = false;
          this.errorAlert = '';
        })
    }
    .padding(24)
    .backgroundColor(ArenaTheme.surface)
    .borderRadius(16)
  }

  @Builder
  missing() {
    Column({ space: 16 }) {
      Text(localeStore.L.philosopherMissing).fontSize(22).fontWeight(FontWeight.Bold)
      Button(localeStore.L.backToPhilosophyHome)
        .backgroundColor(ArenaTheme.purpleAccent)
        .fontColor(Color.White)
        .onClick(() => this.pageStack.clear())
    }
    .width('100%')
    .height('100%')
    .justifyContent(FlexAlign.Center)
  }

  @Builder
  battleHeader(philosopher: Philosopher) {
    Row() {
      Button({ type: ButtonType.Normal }) {
        Row({ space: 4 }) {
          Text('â€¹').fontColor(ArenaTheme.textMuted)
          Text(localeStore.L.backToMap).fontColor(ArenaTheme.textMuted)
        }
      }
      .backgroundColor(Color.Transparent)
      .onClick(() => this.pageStack.clear())
      Blank()
      Column({ space: 2 }) {
        Text(philosopherDisplayName(philosopher, localeStore.L.prefersEnglish))
          .fontSize(16)
          .fontWeight(FontWeight.Medium)
          .fontColor(ArenaTheme.textPrimary)
        Text(philosopher.school).fontSize(12).fontColor(ArenaTheme.textMuted)
      }
      .alignItems(HorizontalAlign.End)
    }
    .width('100%')
  }

  @Builder
  content(philosopher: Philosopher) {
    if (this.stage === 'topic') {
      this.topicStage(philosopher);
    } else if (this.stage === 'choose') {
      this.chooseStage();
    } else if (this.stage === 'debate') {
      this.debateStage(philosopher);
    } else {
      this.revealStage(philosopher);
    }
  }

  @Builder
  topicStage(philosopher: Philosopher) {
    if (this.isTopicLoading) {
      Column({ space: 12 }) {
        LoadingProgress().color(ArenaTheme.purpleAccent)
        Text(localeStore.L.tablePreparing).fontSize(12).fontColor(ArenaTheme.textMuted)
      }
      .width('100%')
      .padding({ top: 40, bottom: 40 })
    } else if (this.topicLoadError) {
      Column({ space: 16 }) {
        Text(this.topicLoadError).fontSize(14).fontColor('#EF4444E6').textAlign(TextAlign.Center)
        Button(localeStore.L.topicRetry)
          .backgroundColor(ArenaTheme.purpleAccent)
          .fontColor(Color.White)
          .onClick(() => {
            this.topicRetryNonce++;
            this.loadTopic(philosopher);
          })
      }
      .width('100%')
      .padding({ top: 24, bottom: 24 })
    } else if (this.topic) {
      Column({ space: 20 }) {
        Text(localeStore.L.currentDebateTopic)
          .fontSize(12)
          .fontWeight(FontWeight.Medium)
          .fontColor('#A855F7E6')
        Text(this.topic.question)
          .fontSize(16)
          .fontWeight(FontWeight.Medium)
          .fontColor(ArenaTheme.textPrimary)
        Text(localeStore.L.agentDisclaimer).fontSize(12).fontColor(ArenaTheme.textMuted)
        Row({ space: 14 }) {
          this.topicCard(
            localeStore.L.philosopherStanceTitle(philosopherDisplayName(philosopher, localeStore.L.prefersEnglish)),
            this.topic.philosopherView,
            true
          )
          this.topicCard(localeStore.L.oppositeStance, this.topic.oppositeView, false)
        }
        .width('100%')
        .alignItems(VerticalAlign.Top)
        Button(localeStore.L.startDebate)
          .width('100%')
          .height(48)
          .fontSize(16)
          .fontWeight(FontWeight.Bold)
          .fontColor(Color.White)
          .backgroundColor(ArenaTheme.purpleAccent)
          .borderRadius(12)
          .onClick(() => { this.stage = 'choose'; })
      }
      .alignItems(HorizontalAlign.Start)
      .width('100%')
    }
  }

  @Builder
  topicCard(title: string, text: string, accent: boolean) {
    Column({ space: 10 }) {
      Text(title)
        .fontSize(16)
        .fontWeight(FontWeight.Bold)
        .fontColor(accent ? ArenaTheme.purpleAccent : ArenaTheme.textPrimary)
      Text(text).fontSize(14).fontColor('#D1D5DB')
    }
    .padding(16)
    .layoutWeight(1)
    .alignItems(HorizontalAlign.Start)
    .backgroundColor(ArenaTheme.surface)
    .border({
      width: 2,
      color: accent ? '#A855F773' : ArenaTheme.border,
      radius: 14
    })
  }

  @Builder
  chooseStage() {
    Column({ space: 18 }) {
      Text(localeStore.L.yourStanceQuestion).fontSize(22).fontWeight(FontWeight.Bold).fontColor(ArenaTheme.textPrimary)
      Text(localeStore.L.debateFlowHint).fontSize(12).fontColor(ArenaTheme.textMuted)
      Row({ space: 12 }) {
        this.chooseButton(localeStore.L.agree, true, () => this.handleChoose(PhilosophyChoice.AGREE))
        this.chooseButton(localeStore.L.disagree, false, () => this.handleChoose(PhilosophyChoice.DISAGREE))
        this.chooseButton(localeStore.L.uncertain, false, () => this.handleChoose(PhilosophyChoice.UNCERTAIN))
      }
      .width('100%')
    }
  }

  @Builder
  chooseButton(label: string, accent: boolean, action: () => void) {
    Text(label)
      .padding(24)
      .layoutWeight(1)
      .textAlign(TextAlign.Center)
      .fontColor(ArenaTheme.textPrimary)
      .backgroundColor(accent ? '#A855F726' : ArenaTheme.surface)
      .border({
        width: 2,
        color: accent ? ArenaTheme.purpleAccent : ArenaTheme.border,
        radius: 14
      })
      .onClick(action)
  }

  @Builder
  debateStage(philosopher: Philosopher) {
    if (!this.topic) {
      Text(localeStore.L.topicGenerating).fontColor(ArenaTheme.textMuted)
    } else {
      this.debateStageContent(philosopher);
    }
  }

  @Builder
  debateStageContent(philosopher: Philosopher) {
    Column({ space: 0 }) {
      if (this.topic) {
        Column({ space: 4 }) {
          Text(localeStore.L.currentDebateTopic).fontSize(11).fontColor('#A855F7E6')
          Text(this.topic!.question)
            .fontSize(14)
            .fontWeight(FontWeight.Medium)
            .fontColor(ArenaTheme.textPrimary)
        }
        .alignItems(HorizontalAlign.Start)
        .width('100%')
        .padding(12)
        .backgroundColor(ArenaTheme.background)
        .border({ width: { bottom: 1 }, color: ArenaTheme.border })
      }

      Scroll() {
        Column({ space: 14 }) {
          Row({ space: 6 }) {
            Text('âš ').fontSize(12)
            Text(localeStore.L.debateRoundHint).fontSize(12).fontColor(ArenaTheme.textMuted)
          }
          ForEach(this.messages, (m: PBMessage) => {
            this.messageBubble(m, philosopher);
          }, (m: PBMessage) => m.id)
          if (this.isThinking && this.thinkingRole === 'judge') {
            Text(localeStore.L.judgeThinking).fontSize(12).fontColor(ArenaTheme.textMuted)
          }
        }
        .padding(12)
        .width('100%')
      }
      .constraintSize({ maxHeight: 420 })

      Column({ space: 10 }) {
        Row({ space: 10 }) {
          TextInput({ placeholder: localeStore.L.continueYourThought, text: this.userInput })
            .layoutWeight(1)
            .fontColor(ArenaTheme.textPrimary)
            .enabled(!this.isThinking)
            .onChange((v: string) => { this.userInput = v; })
          Button('ğŸ’¬')
            .enabled(this.userInput.trim().length > 0 && !this.isThinking && this.choice !== null)
            .onClick(() => { this.handleUserTurn(philosopher); })
        }
        Button(localeStore.L.goToSummary)
          .width('100%')
          .height(44)
          .fontColor(Color.Black)
          .backgroundColor('#FACC15D9')
          .borderRadius(10)
          .enabled((this.canReveal || this.messages.length >= 4) && this.choice !== null)
          .onClick(() => { this.handleReveal(philosopher); })
      }
      .padding(12)
      .width('100%')
      .backgroundColor(ArenaTheme.surface)
      .border({ width: { top: 1 }, color: ArenaTheme.border })
    }
    .width('100%')
    .backgroundColor(ArenaTheme.surface)
    .borderRadius(12)
    .border({ width: 1, color: ArenaTheme.border })
  }

  @Builder
  messageBubble(m: PBMessage, philosopher: Philosopher) {
    Column({ space: 6 }) {
      Text(this.messageLabel(m.role, philosopher))
        .fontSize(11)
        .fontColor(ArenaTheme.textMuted)
      if (this.isThinking && this.thinkingRole === 'philosopher' && m.role === 'philosopher'
        && m.id.startsWith('to-') && m.content.length === 0) {
        Text(localeStore.L.philosopherThinking(philosopherDisplayName(philosopher, localeStore.L.prefersEnglish)))
          .fontSize(14)
          .fontStyle(FontStyle.Italic)
          .fontColor(ArenaTheme.textMuted)
      } else {
        Text(m.content).fontSize(14).fontColor(ArenaTheme.textPrimary)
      }
    }
    .padding(12)
    .width('100%')
    .alignItems(HorizontalAlign.Start)
    .backgroundColor(this.messageBg(m.role))
    .border({ width: 1, color: this.messageBorder(m.role), radius: 10 })
  }

  @Builder
  revealStage(philosopher: Philosopher) {
    Column({ space: 14 }) {
      Text(localeStore.L.fullAnalysis).fontSize(22).fontWeight(FontWeight.Bold).fontColor(ArenaTheme.textPrimary)
      Text(this.isGeneratingSummary ? localeStore.L.agentGeneratingSummary
        : (this.fullExplanation.length === 0 ? localeStore.L.summaryMissing : this.fullExplanation))
        .fontSize(16)
        .fontColor('#D1D5DB')
      if (this.topic) {
        DebateSummarySection({
          philosopher,
          question: this.topic.question,
          userChoice: this.choice,
          userReason: this.messages.filter((m: PBMessage) => m.role === 'user').map((m: PBMessage) => m.content).join('\n')
        })
      }
      Row({ space: 12 }) {
        Button(localeStore.L.backToMap)
          .layoutWeight(1)
          .height(44)
          .border({ width: 1, color: ArenaTheme.border, radius: 10 })
          .onClick(() => this.pageStack.clear())
        Button(localeStore.L.viewMindProfile)
          .layoutWeight(1)
          .height(44)
          .fontColor(Color.White)
          .backgroundColor(ArenaTheme.purpleAccent)
          .borderRadius(10)
          .onClick(() => {
            this.pageStack.clear();
            this.pageStack.pushPath({ name: AppRoutes.profile() });
          })
      }
      .width('100%')
    }
    .padding(18)
    .width('100%')
    .backgroundColor(ArenaTheme.surface)
    .border({ width: 1, color: ArenaTheme.border, radius: 14 })
  }

  private messageLabel(role: PBMessageRole, philosopher: Philosopher): string {
    if (role === 'user') {
      return localeStore.L.you;
    }
    if (role === 'philosopher') {
      return philosopherDisplayName(philosopher, localeStore.L.prefersEnglish);
    }
    return localeStore.L.judge;
  }

  private messageBorder(role: PBMessageRole): ResourceColor {
    if (role === 'user') {
      return '#A855F799';
    }
    if (role === 'judge') {
      return '#FACC1573';
    }
    return ArenaTheme.border;
  }

  private messageBg(role: PBMessageRole): ResourceColor {
    if (role === 'user') {
      return '#A855F71F';
    }
    if (role === 'judge') {
      return '#FACC1514';
    }
    return ArenaTheme.surface;
  }

  private recordMessageRole(m: PBMessage): string {
    if (m.role === 'user') {
      return 'user';
    }
    if (m.role === 'philosopher') {
      return 'philosopher';
    }
    return 'judge';
  }

  private toRecordMessage(m: PBMessage): Record<string, string> {
    const out: Record<string, string> = {};
    out['role'] = this.recordMessageRole(m);
    out['content'] = m.content;
    return out;
  }

  private handleChoose(c: PhilosophyChoice): void {
    this.choice = c;
    this.stage = 'debate';
    this.canReveal = false;
    this.messages = [
      new PBMessage(`${Date.now()}`, 'judge', localeStore.L.judgeOpeningAfterChoice(localeStore.L.choiceDisplay(c)))
    ];
  }

  private async loadTopic(philosopher: Philosopher): Promise<void> {
    this.isTopicLoading = true;
    this.topicLoadError = '';
    try {
      const resp = await ArenaAPI.generateTopic(
        philosopher.nameCN,
        philosopher.school,
        philosopher.keyIdeas,
        localeStore.L.prefersEnglish ? 'en' : 'zh'
      );
      const parsed = resp.debateTopic ?? JsonPayload.parse<DebateTopicContent>(resp.text);
      if (parsed && parsed.question && parsed.philosopherView && parsed.oppositeView) {
        this.topic = parsed;
        this.fullExplanation = parsed.fullExplanation ?? '';
        this.topicLoadError = '';
      } else {
        throw new Error(localeStore.L.topicBadJson);
      }
    } catch (e) {
      this.topic = null;
      this.topicLoadError = (e as Error).message ?? String(e);
    }
    this.isTopicLoading = false;
  }

  private choiceLabel(c: PhilosophyChoice): string {
    return c;
  }

  private historyBlock(msgs: PBMessage[], philosopher: Philosopher): string {
    const top = this.topic!;
    const lines = msgs.map((m: PBMessage) => {
      let who = localeStore.L.user;
      if (m.role === 'judge') {
        who = localeStore.L.judge;
      } else if (m.role === 'philosopher') {
        who = philosopherDisplayName(philosopher, localeStore.L.prefersEnglish);
      }
      return `${who}ï¼š${m.content}`;
    }).join('\n');
    return `è¾©é¢˜ï¼š${top.question}\nå“²å­¦å®¶ï¼š${philosopher.nameCN}ï¼ˆ${philosopher.school}ï¼‰\nç”¨æˆ·ç«‹åœºï¼š${this.choiceLabel(this.choice!)}\nå†å²ï¼š\n${lines}`;
  }

  private async handleUserTurn(philosopher: Philosopher): Promise<void> {
    const content = this.userInput.trim();
    if (!content || !this.choice || !this.topic || this.isThinking) {
      return;
    }
    const userRowId = `${Date.now()}-user`;
    this.userInput = '';
    this.isThinking = true;
    const userMsg = new PBMessage(userRowId, 'user', content);
    let next = this.messages.concat([userMsg]);
    this.messages = next;

    const localeCode = localeStore.L.prefersEnglish ? 'en' : 'zh';
    const keyIdeas = philosopher.keyIdeas.join('ã€‚');
    const summary = philosopher.summary ?? '';
    const userStance = this.choiceLabel(this.choice);

    const streamPhilosopher = async (mode: string, prior: PBMessage[]): Promise<PBMessage> => {
      const msgId = `${mode}-${Date.now()}`;
      let row = new PBMessage(msgId, 'philosopher', '');
      this.thinkingRole = 'philosopher';
      this.messages = prior.concat([row]);
      const hist = this.historyBlock(prior, philosopher);
      const onDelta = (_d: string, acc: string) => {
        row = new PBMessage(msgId, 'philosopher', streamDisplay(acc));
        this.messages = prior.concat([row]);
      };
      const resp = mode === 'to-user'
        ? await ArenaAPI.streamPhilosophyPhilosopherToUser(
          this.topic!.question, philosopher.id,
          philosopherDisplayName(philosopher, localeStore.L.prefersEnglish),
          philosopher.school, keyIdeas, summary, userStance, hist, localeCode, onDelta)
        : await ArenaAPI.streamPhilosophyPhilosopherToJudge(
          this.topic!.question, philosopher.id,
          philosopherDisplayName(philosopher, localeStore.L.prefersEnglish),
          philosopher.school, keyIdeas, summary, userStance, hist, localeCode, onDelta);
      const final = streamDisplay(resp.text);
      if (!final) {
        throw new Error('empty response');
      }
      const done = new PBMessage(msgId, 'philosopher', final);
      this.messages = prior.concat([done]);
      return done;
    };

    const streamJudge = async (prior: PBMessage[]): Promise<JudgeStreamOutcome> => {
      const msgId = `judge-${Date.now()}`;
      let row = new PBMessage(msgId, 'judge', '');
      this.thinkingRole = 'judge';
      this.messages = prior.concat([row]);
      const hist = this.historyBlock(prior, philosopher);
      const onDelta = (_d: string, acc: string) => {
        row = new PBMessage(msgId, 'judge', judgeStreamDisplay(acc));
        this.messages = prior.concat([row]);
      };
      const resp = await ArenaAPI.streamPhilosophyJudgeStep(
        this.topic!.question,
        philosopherDisplayName(philosopher, localeStore.L.prefersEnglish),
        philosopher.school, userStance, hist, localeCode, onDelta);
      if (!resp.philosophyJudge) {
        throw new Error(localeStore.L.topicBadJson);
      }
      const judge = new JudgeStepResult(
        resp.philosophyJudge.judgeSpeaks,
        resp.philosophyJudge.judgeMessage,
        resp.philosophyJudge.addressTo ?? null,
        resp.philosophyJudge.continueDebate
      );
      if (judge.judgeSpeaks && judge.judgeMessage.length > 0) {
        const final = judgeStreamDisplay(resp.text).length === 0 ? judge.judgeMessage : judgeStreamDisplay(resp.text);
        const done = new PBMessage(msgId, 'judge', final);
        this.messages = prior.concat([done]);
        return new JudgeStreamOutcome(judge, done);
      }
      this.messages = prior;
      return new JudgeStreamOutcome(judge, null);
    };

    try {
      const philToUser = await streamPhilosopher('to-user', next);
      let working = next.concat([philToUser]);
      const judgeResult = await streamJudge(working);
      if (judgeResult.judgeMsg) {
        working = working.concat([judgeResult.judgeMsg]);
      }
      if (judgeResult.judge.judgeSpeaks && judgeResult.judge.addressTo === 'philosopher') {
        const philToJudge = await streamPhilosopher('to-judge', working);
        working = working.concat([philToJudge]);
        this.messages = working;
      }
      this.canReveal = judgeResult.judge.continueDebate === false;
    } catch (e) {
      this.messages = this.messages.filter((m: PBMessage) => m.id !== userRowId);
      this.userInput = content;
      this.errorAlert = (e as Error).message ?? String(e);
      this.showErrorDialog = true;
    }
    this.isThinking = false;
    this.thinkingRole = null;
  }

  private async handleReveal(philosopher: Philosopher): Promise<void> {
    if (!this.choice || !this.topic) {
      return;
    }
    this.stage = 'reveal';
    this.isGeneratingSummary = true;
    this.fullExplanation = '';
    const history = this.messages.map((m: PBMessage) => {
      let who = localeStore.L.user;
      if (m.role === 'judge') {
        who = localeStore.L.judge;
      } else if (m.role === 'philosopher') {
        who = philosopherDisplayName(philosopher, localeStore.L.prefersEnglish);
      }
      return `${who}ï¼š${m.content}`;
    }).join('\n');

    const summaryQuery = `[ROLE]\nCA-Echo-LLM\n\n[TASK]\næ ¹æ®è¾©è®ºå†å²ç”Ÿæˆå®Œæ•´æ€»ç»“è§£é‡Šã€‚\n\n[RETURN_FORMAT]\njson\n\n[CONSTRAINTS]\nä¸­æ–‡ï¼›ä»…è¿”å› JSONï¼›å†…å®¹æœ‰å±‚æ¬¡\n\n[ACCEPTANCE_CRITERIA]\nè¿”å› fullExplanation å­—æ®µ\n\nè¾©é¢˜ï¼š${this.topic.question}\nå“²å­¦å®¶ï¼š${philosopher.nameCN}\nç”¨æˆ·ç«‹åœºï¼š${this.choiceLabel(this.choice)}\nå†å²ï¼š\n${history}`;

    try {
      const resp = await ArenaAPI.runEcho(summaryQuery);
      const parsed = JsonPayload.parse<SummaryOnly>(resp.text);
      if (parsed?.fullExplanation && parsed.fullExplanation.length > 0) {
        this.fullExplanation = parsed.fullExplanation;
        if (AuthStore.bearerToken && this.topic) {
          const choiceText = localeStore.L.choiceDisplay(this.choice);
          ArenaAPI.saveBattleRecord(
            'philosophy',
            this.topic.question,
            choiceText,
            parsed.fullExplanation,
            false,
            this.messages.map((m: PBMessage) => this.toRecordMessage(m))
          ).catch(() => {});
        }
      } else {
        this.errorAlert = localeStore.L.topicBadJson;
        this.showErrorDialog = true;
      }
    } catch (e) {
      this.errorAlert = (e as Error).message ?? String(e);
      this.showErrorDialog = true;
    }
    this.isGeneratingSummary = false;
  }
}
