    content(philosopher, parent = null) {
        this.observeComponentCreation2((elmtId, isInitialRender) => {
            If.create();
            if (this.stage === 'topic') {
                this.ifElseBranchUpdateFunction(0, () => {
                    this.topicStage.bind(this)(philosopher);
