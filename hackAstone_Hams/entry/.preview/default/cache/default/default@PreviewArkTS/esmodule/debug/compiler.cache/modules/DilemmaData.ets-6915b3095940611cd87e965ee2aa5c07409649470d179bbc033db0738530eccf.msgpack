export interface MoralDilemmaOptionInit {
  id: string;
  labelZh: string;
  labelEn: string;
  summaryZh: string;
  summaryEn: string;
  stancePromptZh: string;
  stancePromptEn: string;
}

export interface MoralDilemmaInit {
  id: string;
  titleZh: string;
  titleEn: string;
  subtitleZh: string;
  subtitleEn: string;
  imageAltZh: string;
  imageAltEn: string;
  imageCaptionZh: string;
  imageCaptionEn: string;
  questionZh: string;
  questionEn: string;
  promptLeadZh: string;
  promptLeadEn: string;
  options: MoralDilemmaOptionInit[];
  recommendedPhilosopherIds: string[];
}

export class MoralDilemmaOption {
  id: string = '';
  labelZh: string = '';
  labelEn: string = '';
  summaryZh: string = '';
  summaryEn: string = '';
  stancePromptZh: string = '';
  stancePromptEn: string = '';

  constructor(init: MoralDilemmaOptionInit) {
    this.id = init.id;
    this.labelZh = init.labelZh;
    this.labelEn = init.labelEn;
    this.summaryZh = init.summaryZh;
    this.summaryEn = init.summaryEn;
    this.stancePromptZh = init.stancePromptZh;
    this.stancePromptEn = init.stancePromptEn;
  }

  label(en: boolean): string {
    return en ? this.labelEn : this.labelZh;
  }

  summary(en: boolean): string {
    return en ? this.summaryEn : this.summaryZh;
  }

  stancePrompt(en: boolean): string {
    return en ? this.stancePromptEn : this.stancePromptZh;
  }
}

export class MoralDilemma {
  id: string = '';
  titleZh: string = '';
  titleEn: string = '';
  subtitleZh: string = '';
  subtitleEn: string = '';
  imageAltZh: string = '';
  imageAltEn: string = '';
  imageCaptionZh: string = '';
  imageCaptionEn: string = '';
  questionZh: string = '';
  questionEn: string = '';
  promptLeadZh: string = '';
  promptLeadEn: string = '';
  options: MoralDilemmaOption[] = [];
  recommendedPhilosopherIds: string[] = [];

  constructor(init: MoralDilemmaInit) {
    this.id = init.id;
    this.titleZh = init.titleZh;
    this.titleEn = init.titleEn;
    this.subtitleZh = init.subtitleZh;
    this.subtitleEn = init.subtitleEn;
    this.imageAltZh = init.imageAltZh;
    this.imageAltEn = init.imageAltEn;
    this.imageCaptionZh = init.imageCaptionZh;
    this.imageCaptionEn = init.imageCaptionEn;
    this.questionZh = init.questionZh;
    this.questionEn = init.questionEn;
    this.promptLeadZh = init.promptLeadZh;
    this.promptLeadEn = init.promptLeadEn;
    const opts: MoralDilemmaOption[] = [];
    for (let i = 0; i < init.options.length; i++) {
      opts.push(new MoralDilemmaOption(init.options[i]));
    }
    this.options = opts;
    this.recommendedPhilosopherIds = init.recommendedPhilosopherIds;
  }

  title(en: boolean): string {
    return en ? this.titleEn : this.titleZh;
  }

  subtitle(en: boolean): string {
    return en ? this.subtitleEn : this.subtitleZh;
  }

  imageAlt(en: boolean): string {
    return en ? this.imageAltEn : this.imageAltZh;
  }

  imageCaption(en: boolean): string {
    return en ? this.imageCaptionEn : this.imageCaptionZh;
  }

  question(en: boolean): string {
    return en ? this.questionEn : this.questionZh;
  }

  promptLead(en: boolean): string {
    return en ? this.promptLeadEn : this.promptLeadZh;
  }
}

